outputs/*.tex
outputs/*.png
outputs/*.pdf
# outputs/*.json and outputs/panel_*.csv are intentionally NOT ignored (used by Streamlit app)
# paper/results.html is intentionally NOT ignored so it can be emailed via GitHub

# Raw data — too large for git
data/raw/*.csv
data/raw/*.zip

# Jupyter checkpoints
.ipynb_checkpoints/
